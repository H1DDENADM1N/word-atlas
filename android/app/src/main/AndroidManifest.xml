<?xml version="1.0" encoding="utf-8"?>
<!--
  Word Atlas · offline edition

  There is intentionally no <uses-permission> element in this manifest — not even
  android.permission.INTERNET. Without it the OS refuses to create sockets for
  this UID, so the app cannot reach the network under any circumstances. All
  content is unpacked from the APK and opened through file:///android_asset.
  The widget keep-alive service is a plain Service, so it needs no permission
  and shows no notification.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tech.wordatlas.app">

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 选词翻译：长按某词弹出的翻译器选择器里可选词光 -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 分享搜索：在别的app点分享可选词光，由词光搜索该词 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Only while widgets are on the home screen: keeps the launcher's
          widget PendingIntents alive when the task is swiped out of recents,
          and pulls an hourly refresh on every local hour boundary. Still a
          plain Service: no permission, no alarm, no notification.
          See WidgetKeepAlive.java.
        -->
        <service
            android:name=".WidgetKeepAlive"
            android:exported="false"
            android:stopWithTask="false" />

        <!--
          Hands a generated card to another app. Not exported: a receiver can
          only read a file while the share intent's one-shot grant is alive.
        -->
        <provider
            android:name=".ShareProvider"
            android:authorities="tech.wordatlas.app.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          Home-screen widgets. Not exported: the system still delivers
          APPWIDGET_UPDATE to a non-exported receiver, and the extra refresh
          broadcast is package-scoped. No permission is added — in particular
          RECEIVE_BOOT_COMPLETED is unnecessary because the launcher rebinds
          widgets and sends APPWIDGET_UPDATE after a reboot.
        -->
        <receiver android:name=".WidgetTough" android:label="@string/widget_tough_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="tech.wordatlas.app.WIDGET_REFRESH" />
                <action android:name="tech.wordatlas.app.WIDGET_NEXT" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Re-render immediately on a day/night switch. -->
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tough_info" />
        </receiver>

        <receiver android:name=".WidgetQuote" android:label="@string/widget_quote_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="tech.wordatlas.app.WIDGET_REFRESH" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Re-render immediately on a day/night switch. -->
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quote_info" />
        </receiver>

        <receiver android:name=".WidgetPlan" android:label="@string/widget_plan_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="tech.wordatlas.app.WIDGET_REFRESH" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Re-render immediately on a day/night switch. -->
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_plan_info" />
        </receiver>
    </application>

</manifest>
