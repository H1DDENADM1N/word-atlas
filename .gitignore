node_modules/
dist/
dist-android/
.local/
.env
.env.*
!.env.example
output/
*.zip
.DS_Store
.playwright-cli/
*.tsbuildinfo

# Android build output, signing key and local preview tree
android/build/
android/keystore/
.apk-preview/
*.apk
*.apk.idsig

# Offline TTS runtime + voices, fetched by scripts/android/fetch_tts.py (~540 MB)
android/vendor/
.cache/
.verify/

# Agent workspace state (session notes), not part of the app
.workbuddy-ai/

# Scratch: local verification scripts and screenshots, and copies of the
# reference site's minified bundle pulled down while reverse-engineering it.
.devcheck/
/ref.js
/ref.css
/ref.html
/ref-atlas.js

# Third-party dictionaries, not part of the app:
# 雅思真题例句词典 -> scripts/atlas/import_ielts.py, OALDPEX -> import_syllables.py
/雅思真题例句词典
/OALDPEX

# Word pronunciations are imported from OALDPEX by scripts/atlas/import_audio.py.
# They are Oxford University Press's recordings, not ours, so they stay on the
# build machine: `python3 scripts/atlas/import_audio.py` recreates them, and a
# build without them falls back to the bundled Kokoro voice.
/public/atlas/audio/uk/
/public/atlas/audio/us/
